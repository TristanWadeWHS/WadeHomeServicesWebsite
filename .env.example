# Preferred Google API service account credential. Do not commit real secrets.
GOOGLE_SERVICE_ACCOUNT_JSON=""

# Optional fallback if JSON is not used.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# Existing Wade Home Services Google Sheet and Calendar.
GOOGLE_SPREADSHEET_ID=""
# Optional legacy/fallback spreadsheet id name.
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SHEET_TAB="Open Leads"
GOOGLE_CALENDAR_ID=""

# Scheduling rules.
BOOKING_TIMEZONE="America/Los_Angeles"
BOOKING_OPENING_HOUR="7"
BOOKING_CLOSING_HOUR="20"
BOOKING_APPOINTMENT_MINUTES="120"
BOOKING_INTERVAL_MINUTES="60"
BOOKING_BUFFER_MINUTES="0"
BOOKING_MIN_ADVANCE_HOURS="12"
BOOKING_HORIZON_DAYS="21"

# Cloudflare Turnstile. Public key can be exposed to the browser if wired later.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Owner-only approval dashboard.
OWNER_APPROVAL_TOKEN=""
OWNER_APPROVAL_PORTAL_URL=""

# Owner-only new booking request notification email. Configure with Brevo
# by setting a server-side API key manually.
BREVO_API_KEY=""
OWNER_NOTIFICATION_EMAIL=""

# Photo storage adapter.
# Leave blank to auto-enable Vercel Blob when BLOB_STORE_ID or legacy
# BLOB_READ_WRITE_TOKEN is present. Use "disabled" to force uploads off.
# Use "mock" only for local/preview integration testing; it validates files and
# returns non-public mock references rather than durable customer-photo storage.
# Use "vercel-blob" for durable private Vercel Blob uploads.
PHOTO_STORAGE_MODE=""
BLOB_STORE_ID=""
# Legacy fallback only. New Vercel Blob project connections should use OIDC
# instead of a long-lived read/write token.
BLOB_READ_WRITE_TOKEN=""
