# Google API service account credentials. Do not commit real secrets.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# Existing Wade Home Services Google Sheet and Calendar.
GOOGLE_SPREADSHEET_ID=""
GOOGLE_SHEET_TAB="Open Leads"
GOOGLE_CALENDAR_ID=""

# Scheduling rules.
BOOKING_TIMEZONE="America/Los_Angeles"
BOOKING_OPENING_HOUR="7"
BOOKING_CLOSING_HOUR="20"
BOOKING_APPOINTMENT_MINUTES="120"
BOOKING_INTERVAL_MINUTES="60"
BOOKING_BUFFER_MINUTES="0"
BOOKING_MIN_ADVANCE_HOURS="12"
BOOKING_HORIZON_DAYS="21"

# Cloudflare Turnstile. Public key can be exposed to the browser if wired later.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Photo storage adapter.
# Use "disabled" until an approved private storage provider is configured.
# Use "mock" only for local/preview integration testing; it validates files and
# returns non-public mock references rather than durable customer-photo storage.
PHOTO_STORAGE_MODE="disabled"

